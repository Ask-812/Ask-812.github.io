---
import Base from '../layouts/Base.astro';

const primary = [
  {
    name: 'oswright',
    tagline: 'OS automation framework and MCP server',
    repo: 'https://github.com/Ask-812/oswright',
    stack: ['Python', 'ctypes/COM', 'DXGI', 'MCP'],
    body: `Desktop automation for AI agents that observes incrementally instead of taking a
      screenshot every step. 43 MCP tools across 25 modules and 7,624 lines, 237 tests, plus 13
      benchmark scripts. The interesting part is hand-written COM bindings to DXGI Desktop
      Duplication: the median observation alters 0.012% of pixels, which cuts token cost 23× and
      brings a step from 212 ms to 33 ms.`,
    note: `Head-to-head against Windows-MCP on identical tasks graded by the applications' own UI
      Automation state: 16.9× lower token cost, at 19/20 tasks against their 20/20. It is cheaper
      and slightly less reliable — both halves are true. Published on PyPI and the official MCP
      registry.`,
  },
  {
    name: 'credit-scorecard',
    tagline: 'Probability-of-default credit scorecard',
    repo: 'https://github.com/Ask-812/credit-scorecard',
    stack: ['Python', 'statsmodels', 'SQL', 'SQLite'],
    body: `A full PD scorecard over 618k Lending Club loans: weight-of-evidence binning into
      logistic regression, then an integer points table a credit officer could actually read.
      Trained pre-2015 and tested on 2015 for an honest out-of-time Gini of 0.300 — not an
      in-sample number. Cohort and vintage default-rate analysis in SQL. 215 tests.`,
    note: `The result I care about is the bug I caught. The recoveries field is only populated after
      a loan defaults, so it leaks the label; on its own it scores Gini 0.72 and inflates the whole
      model. Finding that is the work — the inflated number is not a performance claim.`,
  },
  {
    name: 'scada-dash',
    tagline: 'AMRUT water utility SCADA — deployed',
    repo: null,
    stack: ['FastAPI', 'React 18', 'TypeScript', 'MS SQL Server', 'SSE'],
    body: `A multi-site web SCADA system built for U.P. Jal Nigam, Bahraich, under the AMRUT urban
      water mission. RBAC multi-tenancy, live alarms, scheduled PDF reporting, RS256-signed
      licensing and a full audit trail. Real operators, real water infrastructure.`,
    note: null,
  },
  {
    name: 'FinSpark',
    tagline: 'Integration configuration and orchestration engine',
    repo: 'https://github.com/Ask-812/FinSpark',
    stack: ['FastAPI', 'React 19', 'Groq Llama 3.3 70B'],
    body: `A business-requirements document goes in and a working integration comes out. An LLM
      parser feeds an auto-configuration engine across 10 India lending adapters, with 37 executing
      pre- and post-call hooks, then simulate → approve → deploy → one-click rollback. 31 endpoints,
      JWT tenant isolation, a per-tenant Fernet credential vault, PII masking, an immutable
      IP-stamped audit trail and 5 self-healing auto-fix rules. 248 tests across 19 modules in 3.5 s.`,
    note: 'Built by Team Sudos — four people. Not solo work.',
  },
  {
    name: 'Aurora',
    tagline: 'Self-learning notification orchestrator',
    repo: 'https://github.com/Ask-812/Aurora',
    stack: ['Python', 'XGBoost', 'LightGBM'],
    body: `Decides who to notify and when. Churn prediction reaching AUC 0.817 against a computed
      oracle ceiling of 0.854 on a known-data-generating-process benchmark — 96% of what is
      attainable. Thompson-sampling bandits over 600 arms, RFM segmentation, Bayesian and
      frequentist A/B gating, survival analysis, 67 tests in CI.`,
    note: `An earlier version reported R² 0.94. That was target leakage, and it is deleted. Catching
      it is the part worth talking about. Team project — the numbers above are the components I
      built.`,
  },
];

const secondary = [
  {
    name: 'Modbus digital twin',
    tagline: 'BESS hardware-in-the-loop simulator',
    repo: null,
    stack: ['C++', 'Modbus TCP/RTU', 'libmodbus', 'socat', 'systemd'],
    body: `Turned a 7-device energy-storage simulator — grid, battery, BMS, inverter, PLC, contactor,
      EMS — from independent random telemetry into a physically coherent system where control writes
      propagate: an EMS command opening the grid contactor collapses grid voltage and frequency, the
      inverter detects loss of mains, the battery discharges into the load. Patched libmodbus 3.1.6
      from source to lift the broadcast-address restriction, and emulated the RS485 buses with socat
      PTY pairs wired as systemd units.`,
    note: 'A take-home assignment, not a shipped product.',
  },
  {
    name: 'Mediguide',
    tagline: 'AI medical question answering',
    repo: 'https://github.com/Ask-812/Mediguide',
    stack: ['Streamlit', 'Hugging Face', 'PEFT/LoRA'],
    body: `GPT-2 fine-tuned with LoRA and 4-bit quantisation for question answering over medical
      PDFs, with sentence-embedding retrieval and Hugging Face Hub versioning. +20% ROUGE-L over the
      base model. Learned the whole LoRA pipeline in about two weeks.`,
    note: null,
  },
  {
    name: 'SheetCutting',
    tagline: '2D sheet-cutting optimiser',
    repo: 'https://github.com/Ask-812/SheetCutting',
    stack: ['Python', 'GA', 'Simulated annealing', 'ILS'],
    body: `A metaheuristic nesting engine combining a genetic algorithm, simulated annealing and
      iterated local search to place parts on stock sheets with minimum waste.`,
    note: null,
  },
  {
    name: 'Route Optimizer',
    tagline: 'Vehicle routing with GA + ALNS',
    repo: null,
    stack: ['React', 'Node', 'Python', 'MongoDB'],
    body: `Genetic algorithm plus adaptive large neighbourhood search for vehicle routing, comparing
      MaxRects, Guillotine and Strip bin-packing for the loading sub-problem, with live map
      visualisation.`,
    note: null,
  },
  {
    name: 'edms',
    tagline: 'Engineering drawing automation — deployed',
    repo: null,
    stack: ['PHP 8.2', 'MS SQL Server', 'ODA File Converter'],
    body: `A client tool for a transmitter manufacturer that turns a purchase order into the
      corresponding DWG/DXF drawings and certificates automatically, over roughly 24 tables.`,
    note: null,
  },
];
---

<Base
  title="Projects — Arnav Kshirsagar"
  description="Production systems, research code and shipped client tools: oswright, a PD credit scorecard on 618k loans, deployed government SCADA, and more."
>
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">Projects</p>
      <h1>Things I built, and what is actually true about them.</h1>
      <p class="lede">
        Some of these are deployed and have real users. Some are research code where the interesting
        result was a bug I found in my own work. Both are labelled as such — the caveats are part of
        the write-up, not hidden under it.
      </p>
    </section>

    <section>
      <div class="section-head"><h2>Primary</h2></div>
      <div class="cards">
        {
          primary.map((p) => (
            <article class="card">
              <div class="card-head">
                <h3>{p.name}</h3>
                {p.repo ? (
                  <a class="card-meta" href={p.repo}>
                    source &rarr;
                  </a>
                ) : (
                  <span class="badge muted">private</span>
                )}
              </div>
              <p class="card-meta">{p.tagline}</p>
              <p>{p.body}</p>
              {p.note && (
                <p style="color:var(--ink-faint);font-size:0.86rem">{p.note}</p>
              )}
              <div class="tags">
                {p.stack.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section>
      <div class="section-head"><h2>Also built</h2></div>
      <div class="cards">
        {
          secondary.map((p) => (
            <article class="card">
              <div class="card-head">
                <h3>{p.name}</h3>
                {p.repo && (
                  <a class="card-meta" href={p.repo}>
                    source &rarr;
                  </a>
                )}
              </div>
              <p class="card-meta">{p.tagline}</p>
              <p>{p.body}</p>
              {p.note && (
                <p style="color:var(--ink-faint);font-size:0.86rem">{p.note}</p>
              )}
              <div class="tags">
                {p.stack.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section>
      <div class="section-head"><h2>Elsewhere</h2></div>
      <p>
        Security findings are written up separately on the{' '}
        <a href="/security">security research page</a>. Everything public lives at{' '}
        <a href="https://github.com/Ask-812">github.com/Ask-812</a>.
      </p>
    </section>
  </div>
</Base>
